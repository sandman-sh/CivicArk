# CivicArk Network Configuration
VITE_ARKIV_CHAIN_ID=7738577
VITE_ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
VITE_ARKIV_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
VITE_ARKIV_EXPLORER_URL=https://tiramisu.explorer.arkiv.network

# Secure gateway configuration
PORT=8787

# OpenRouter AI defaults (server-side only; never prefix secrets with VITE_)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=replace-me

# Optional AI role authorization (comma-separated lowercase wallet addresses).
# Without a matching allowlisted wallet signature, the assistant is public/read-only.
CIVICARK_ENGINEER_WALLETS=
CIVICARK_CONTRACTOR_WALLETS=
CIVICARK_AUDITOR_WALLETS=

# AssemblyAI voice and realtime transcription (server-side only)
ASSEMBLYAI_API_KEY=replace-me
ASSEMBLYAI_STT_MODEL=u3-rt-pro
ASSEMBLYAI_VOICE_TOKEN_TTL_SECONDS=60
ASSEMBLYAI_MAX_SESSION_SECONDS=900

# Optional evidence photo upload to IPFS (server-side secret; never use VITE_)
PINATA_JWT=replace-me

# Optional server-side relay key. Never expose this through VITE_* or commit it.
# ARKIV_OFFICER_RELAY_KEY=0x...
